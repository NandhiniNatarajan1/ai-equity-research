# Copy to .env and fill in. Never commit .env.

# ---- Postgres ---------------------------------------------------------------
POSTGRES_USER=aer
POSTGRES_PASSWORD=aer
POSTGRES_DB=aer
POSTGRES_PORT=5432

# When running the API outside Docker (e.g. local dev), use localhost.
# When running inside the compose network, docker-compose overrides this
# to point at the "postgres" service.
DATABASE_URL=postgresql+psycopg://aer:aer@localhost:5432/aer

# ---- Services ---------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
MCP_PORT=8765
MCP_SERVER_URL=http://localhost:8765

# ---- SEC EDGAR --------------------------------------------------------------
# EDGAR requires a descriptive User-Agent with a contact email.
# See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=AI Equity Research (natarajan.nan@northeastern.edu)
EDGAR_CACHE_DIR=./data/edgar

# ---- LLM / Embeddings -------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VERIFICATION_MODEL=claude-opus-5-5

# Voyage is preferred for embeddings; OpenAI is the fallback.
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

OPENAI_API_KEY=

# ---- Observability ----------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-equity-research
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- App --------------------------------------------------------------------
LOG_LEVEL=INFO
APP_ENV=dev
